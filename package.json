{
  "name": "monogatari-buzz-maker",
  "version": "1.4.3",
  "private": true,
  "homepage": "https://FURUYAN1234.github.io/viral-radar",
  "description": "物語バズメーカー - 公開Web/RSSトレンドを漫画・動画・小説の制作案へ整理する創作支援ツール",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "prebuild": "npm run check:runtime",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5180 --strictPort",
    "release:preflight": "npm run check:upstreams && powershell -ExecutionPolicy Bypass -File ..\\scripts\\release_app_preflight.ps1 -App viral-radar",
    "predeploy": "npm run release:preflight && npm run build",
    "deploy": "gh-pages -d dist",
    "sync:nano-fallback": "node scripts/sync-nano-fallback-chain.mjs",
    "check:nano-fallback": "node scripts/sync-nano-fallback-chain.mjs --check",
    "check:upstreams": "npm run check:nano-fallback",
    "check:runtime": "node scripts/sync-nano-fallback-chain.mjs --check-bundled",
    "pretest": "npm run check:runtime",
    "test": "node --test",
    "postbuild": "node scripts/web-security.mjs --verify-dist"
  },
  "devDependencies": {
    "gh-pages": "6.3.0",
    "vite": "^6.4.4"
  }
}
